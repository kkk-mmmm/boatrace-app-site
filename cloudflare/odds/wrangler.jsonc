{
  "name": "boatrace-odds",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-11",
  "workers_dev": true,
  "triggers": {"crons": ["* * * * *"]},
  "vars": {
    "SITE_ORIGIN": "https://funeyomi.win",
    "EXTRA_ORIGINS": "https://kkk-mmmm.github.io,https://www.funeyomi.win",
    "PLAYER_MODEL_URL": "https://funeyomi.win/data/player-model.json",
    "VERIFICATION_ARCHIVE_URL": "https://funeyomi.win/data/verification.json",
    "TARGETS_URL": "https://funeyomi.win/data/odds-targets.json"
  },
  "durable_objects": {"bindings": [{"name": "ODDS", "class_name": "OddsCoordinator"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["OddsCoordinator"]}],
  "observability": {"enabled": true}
}
